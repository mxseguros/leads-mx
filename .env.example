# MX Leads — variaveis de ambiente
# Copie para .env.local (apps/web) ou .env (scripts) e preencha.
# Nenhuma chave real entra no repositorio.

# ---------------------------------------------------------------------------
# Supabase — projetos SEPARADOS para dev e prod (item F0-3 do plano)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# A chave secreta (sb_secret_...) ignora RLS. Vive so no servidor: nunca em
# NEXT_PUBLIC_*, nunca em componente de cliente.
SUPABASE_SECRET_KEY=

# String de conexao direta — usada pelos testes de RLS e pelas migrations.
SUPABASE_DB_URL=postgresql://postgres:senha@localhost:54322/postgres

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
# Base publica, usada nos links dos e-mails e no callback do magic link.
NEXT_PUBLIC_URL_BASE=http://localhost:3000

# ---------------------------------------------------------------------------
# Fase 1 — ainda nao usadas na Fase 0, ficam aqui para o pedido nao ser esquecido
# ---------------------------------------------------------------------------
# Cloudflare Turnstile (dependencia E2)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limit da captura publica — Upstash ou Vercel KV (dependencia E3)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# NOTA: o aviso de novo lead por e-mail saiu do escopo, entao a aplicacao nao
# manda e-mail nenhum. O Supabase, sim: ele envia o magic link do login pelo
# SMTP embutido, que e limitado a poucos envios por hora. Para a equipe
# conseguir entrar, configure SMTP proprio no painel do Supabase
# (Authentication > Emails) — isso e ajuste de painel, nao de codigo.
