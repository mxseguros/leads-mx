# MX Leads — variaveis de ambiente
# Copie para .env.local (apps/web) ou .env (scripts) e preencha.
# Nenhuma chave real entra no repositorio.

# ---------------------------------------------------------------------------
# Supabase — projetos SEPARADOS para dev e prod (item F0-3 do plano)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# A service role ignora RLS. Vive so no servidor: nunca em NEXT_PUBLIC_*,
# nunca em componente de cliente, nunca no bundle do widget.
SUPABASE_SERVICE_ROLE_KEY=

# String de conexao direta — usada pelos testes de RLS e pelas migrations.
SUPABASE_DB_URL=postgresql://postgres:senha@localhost:54322/postgres

# ---------------------------------------------------------------------------
# Aplicacao
# ---------------------------------------------------------------------------
# Base publica, usada nos links dos e-mails e no callback do magic link.
NEXT_PUBLIC_URL_BASE=http://localhost:3000

# ---------------------------------------------------------------------------
# Fase 1 — ainda nao usadas na Fase 0, ficam aqui para o pedido nao ser esquecido
# ---------------------------------------------------------------------------
# Cloudflare Turnstile (dependencia E2)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limit da captura publica — Upstash ou Vercel KV (dependencia E3)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# E-mail transacional (dependencia E6)
RESEND_API_KEY=
RESEND_REMETENTE="MX Leads <leads@mxseguros.com.br>"
